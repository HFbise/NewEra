# Copy to .env and fill in. Never commit .env.

# Postgres connection string (Supabase pooler or any Postgres 15+)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# LLM provider: zhipu (default), claude or gemini; set the matching key
AI_PROVIDER=zhipu
ZAI_API_KEY=
# ZAI_API_KEY_2=                    # optional second key, used when the first is rate limited
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional model overrides
# AI_MODEL=glm-4.5-flash
# AI_ROLEPLAY_MODEL=
# AI_BACKGROUND_MODEL=
# AI_FALLBACK_MODEL=glm-4.7-flash

# rules = rule-based parser first, AI only when unsure; ai = AI first
PARSE_MODE=rules
# 0 = use room description templates instead of AI-written dungeon rooms
# AI_ROOMS=1

# Optional: invite code required on the login page
# ACCESS_CODE=
# Required to enable the admin panel at /admin.html
# ADMIN_PASSWORD=
